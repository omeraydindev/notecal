# Master switch for Drive sync. When true, VITE_GOOGLE_CLIENT_ID and VITE_AUTH_API must also be set.
VITE_DRIVE_SYNC_ENABLED=false

# Google OAuth Client ID for Drive API access.
# To get one:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create or select a project
# 3. Enable the Google Drive API
# 4. Create an OAuth 2.0 Client ID (type: Web Application)
# 5. Add your app's origins to "Authorized JavaScript origins"
#    (e.g. http://localhost:5173 for dev, https://yourdomain.com for prod)
# 6. Copy the Client ID here:
VITE_GOOGLE_CLIENT_ID=

# Authorization API backend URL.
# Deploy worker/ as a Cloudflare Worker and set the URL here.
VITE_AUTH_API=
